# Public URL of the FastAPI backend (Railway). The browser calls it directly for
# the SSE search stream, the knowledge page and the recorded demo run.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only: backend URL used by the /api/cron/refresh-scores proxy route.
# Usually the same as NEXT_PUBLIC_API_URL.
BACKEND_URL=http://localhost:8000

# Server-only: Vercel Cron sends `Authorization: Bearer $CRON_SECRET`; the route
# forwards it to the backend. Must match CRON_SECRET on the backend.
CRON_SECRET=
