# ─── Required ────────────────────────────────────────────────────────────────
# Anthropic Console → API keys. Used by the orchestrator, research agents,
# synthesiser and distiller.
ANTHROPIC_API_KEY=your-anthropic-key-here
# Supabase project settings → API → Project URL (local: http://127.0.0.1:54321)
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase project settings → API → anon public key
SUPABASE_KEY=your-supabase-anon-key-here
# api.tfl.gov.uk — only needed by the monthly score refresh (transport scorer)
TFL_APP_KEY=your-tfl-key-here
# Supabase database password — only used locally by `supabase db push`
SUPABASE_DB_PASSWORD=your-db-password-here

# ─── API security (backend) ──────────────────────────────────────────────────
# Header X-Admin-Token for POST /api/admin/distill (and bypasses rate limits).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Shared secret for GET /api/cron/refresh-scores. Must match CRON_SECRET on Vercel.
CRON_SECRET=
# Comma-separated browser origins allowed by CORS, e.g. https://your-app.vercel.app
# (localhost:3000 is always allowed)
FRONTEND_ORIGIN=
# Optional regex for extra origins, e.g. ^https://london-postcode-finder-.*\.vercel\.app$
FRONTEND_ORIGIN_REGEX=

# ─── Cost protection (backend) ───────────────────────────────────────────────
# Searches per IP per rolling hour
RATE_LIMIT_PER_HOUR=5
# Searches per UTC day across all users; beyond this the UI offers the recorded run
DAILY_SEARCH_CAP=100

# ─── Behaviour (optional, defaults shown) ────────────────────────────────────
# Distil the knowledge base every N searches
DISTILL_EVERY_N=10
# Parallel research agents (Claude web search calls)
RESEARCH_CONCURRENCY=5
# Hard stop for one search, in seconds (emits an `error` event)
PIPELINE_TIMEOUT_SECONDS=240
# Time budget for the Context Sub-Agent before the search continues unfiltered
SPAWN_TIMEOUT_SECONDS=90
# Reuse Context Sub-Agent results for this many days
SPAWN_CACHE_MAX_AGE_DAYS=30
# Model names and token budgets
SONNET_MODEL=claude-sonnet-5
HAIKU_MODEL=claude-haiku-4-5-20251001
ORCHESTRATOR_MAX_TOKENS=1500
SYNTHESISER_MAX_TOKENS=8000
RESEARCH_MAX_TOKENS=500
WEB_SEARCH_MAX_TOKENS=2000
DISTILLER_MAX_TOKENS=16000
DISTILLER_EFFORT=medium

# Optional, unused by the pipeline
GROQ_API_KEY=
